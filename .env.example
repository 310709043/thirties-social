EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to keep the Loft open 24h (test bypass for its 00:00–05:00 window).
# Dev builds always bypass via __DEV__ regardless of this flag.
EXPO_PUBLIC_LOFT_ALWAYS_OPEN=

# RevenueCat public SDK keys (per platform). From RevenueCat dashboard → API keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=


# Google Sign-In Web Client ID (Firebase Auth → Google). Public.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
