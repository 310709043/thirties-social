rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True unless the signed-in user is explicitly banned. Used to block banned
    // users from posting (server-side enforcement, not just the client gate).
    // Robust to a missing user doc or an absent isBanned field: only an
    // explicit isBanned == true blocks. A hard get() on a missing doc would
    // otherwise error and silently deny ALL posting.
    function notBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
             || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
    }

    // ── Users ──────────────────────────────────────────
    match /users/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Monetization lock: client may only DECREASE wicks (spending stays
      // client-side). Wick increases, vigil and lastRewardDate are server-only
      // (RevenueCat webhook + daily-reward endpoint).
      allow update: if request.auth != null && request.auth.uid == userId
                    && !('isBanned' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('banReason' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('vigil' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('lastRewardDate' in request.resource.data.diff(resource.data).affectedKeys())
                    && (!('wicks' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.wicks <= resource.data.wicks)
                    && (!('freeMatchesUsed' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.freeMatchesUsed >= resource.data.freeMatchesUsed)
                    && (!('loftFreeUsed' in request.resource.data.diff(resource.data).affectedKeys())
                        || !('loftFreeUsed' in resource.data)
                        || request.resource.data.loftFreeUsed >= resource.data.loftFreeUsed);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Wicks Transactions ──────────────────────────────
    match /wicksTransactions/{txId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Rooms ──────────────────────────────────────────
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null
                    // Sending a message bumps messageCount and extends closesAt.
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['messageCount', 'closesAt']);

      // Room messages subcollection
      match /messages/{msgId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 280
                      && notBanned();
        // Only resonance reaction counts may be updated (by anyone).
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if false;

        // One resonance reaction per user, keyed by uid.
        match /reactions/{reactUid} {
          allow read:                  if request.auth != null;
          allow create, update, delete: if request.auth != null
                                       && request.auth.uid == reactUid;
        }
      }

      // Presence heartbeats — one doc per user, keyed by uid
      match /presence/{presenceUid} {
        allow read:           if request.auth != null;
        allow create, update: if request.auth != null
                              && request.auth.uid == presenceUid;
        allow delete:         if request.auth != null
                              && request.auth.uid == presenceUid;
      }
    }

    // ── Conversations ───────────────────────────────────
    match /conversations/{convId} {
      allow read: if request.auth != null
                  && (resource.data.userAId == request.auth.uid
                      || resource.data.userBId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userAId == request.auth.uid;
      // extendVotes/expiresAt/extended power 續燭 (mutual +30 min extension):
      // expiresAt may only move together with flipping extended false→true, so
      // the clock can never be pushed out a second time.
      allow update: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['messageCount', 'endedAt', 'endedReason',
                                 'extendVotes', 'expiresAt', 'extended',
                                 'rekindleVotes', 'bondVotes'])
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['expiresAt', 'extended'])
                        || (resource.data.get('extended', false) == false
                            && request.resource.data.get('extended', false) == true));
      allow delete: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid);

      match /messages/{msgId} {
        allow read: if request.auth != null
                    && (get(/databases/$(database)/documents/conversations/$(convId)).data.userAId == request.auth.uid
                        || get(/databases/$(database)/documents/conversations/$(convId)).data.userBId == request.auth.uid);
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 280
                      && notBanned();
        allow update: if false;
        allow delete: if request.auth != null
                      && (get(/databases/$(database)/documents/conversations/$(convId)).data.userAId == request.auth.uid
                          || get(/databases/$(database)/documents/conversations/$(convId)).data.userBId == request.auth.uid);
      }
    }

    // ── Awake presence（今晚有 N 人醒著）─────────────────
    // One public heartbeat doc per user (timestamp only) so the home screen
    // can honestly count who's around. No personal data lives here.
    match /presence/{presUid} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == presUid;
    }

    // ── 重逢 Rekindles（明晚再見）────────────────────────
    match /rekindles/{rekId} {
      allow read:   if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid);
      allow create: if request.auth != null
                    && (request.resource.data.userAId == request.auth.uid
                        || request.resource.data.userBId == request.auth.uid);
      // Only opening the reunion may be written (conversationId + status).
      allow update: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['conversationId', 'status']);
      allow delete: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid);
    }

    // ── 熟人 Bonds（留下彼此）────────────────────────────
    match /bonds/{bondId} {
      allow read:   if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // ── 夜信 Letters（慢通信）────────────────────────────
    match /letters/{letterId} {
      // Unclaimed letters must be readable so a stranger can claim one;
      // claimed letters are private to sender + recipient.
      allow read:   if request.auth != null
                    && (resource.data.toId == null
                        || resource.data.fromId == request.auth.uid
                        || resource.data.toId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromId == request.auth.uid
                    && request.resource.data.toId == null
                    && request.resource.data.status == 'unsent'
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 500
                    && notBanned();
      allow update: if request.auth != null
                    && (
                      // Claiming: an unclaimed letter becomes mine.
                      (resource.data.toId == null
                       && request.resource.data.toId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['toId', 'status']))
                      ||
                      // Replying: the recipient writes one reply, once.
                      (resource.data.toId == request.auth.uid
                       && !('replyContent' in resource.data)
                       && request.resource.data.replyContent is string
                       && request.resource.data.replyContent.size() <= 500
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['replyContent', 'toSeed', 'repliedAt', 'status'])
                       && notBanned())
                    );
      allow delete: if request.auth != null && resource.data.fromId == request.auth.uid;
    }

    // ── 回聲 Echoes（結束後的最後一句話）─────────────────
    match /echoes/{echoId} {
      allow read:   if request.auth != null
                    && (resource.data.toId == request.auth.uid
                        || resource.data.fromId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromId == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 200
                    && request.resource.data.read == false
                    && notBanned();
      allow update: if request.auth != null
                    && resource.data.toId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read']);
      allow delete: if request.auth != null
                    && (resource.data.toId == request.auth.uid
                        || resource.data.fromId == request.auth.uid);
    }

    // ── Loft Sessions ───────────────────────────────────
    match /loftSessions/{sessionId} {
      // Anyone can see tonight's sessions (to find others in the Loft)
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ── Loft Ritual Responses (今夜之題) ─────────────────
    match /loftRitualResponses/{responseId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 280;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ── Loft Conversations ──────────────────────────────
    match /loftConversations/{convId} {
      allow read: if request.auth != null
                  && (resource.data.userAId == request.auth.uid
                      || resource.data.userBId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userAId == request.auth.uid;
      // Only allow updating fields that legitimately change during a chat session.
      allow update: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['messageCount', 'endedAt', 'endedReason', 'veils']);
      allow delete: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid);

      match /messages/{msgId} {
        allow read: if request.auth != null
                    && (get(/databases/$(database)/documents/loftConversations/$(convId)).data.userAId == request.auth.uid
                        || get(/databases/$(database)/documents/loftConversations/$(convId)).data.userBId == request.auth.uid);
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 280
                      && notBanned();
        allow update: if false;
        allow delete: if request.auth != null
                      && (get(/databases/$(database)/documents/loftConversations/$(convId)).data.userAId == request.auth.uid
                          || get(/databases/$(database)/documents/loftConversations/$(convId)).data.userBId == request.auth.uid);
      }
    }

    // ── Match Queue ─────────────────────────────────────
    match /matchQueue/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Reports ─────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid;
      allow read:   if request.auth != null
                    && resource.data.reporterId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.reporterId == request.auth.uid;
    }

    // ── Veiled Photos ───────────────────────────────────
    match /veiledPhotos/{photoId} {
      // Sender or the other participant of the conversation may read.
      allow read: if request.auth != null
                  && (resource.data.senderId == request.auth.uid
                      || get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.userAId == request.auth.uid
                      || get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.userBId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.senderId == request.auth.uid;
    }

    // ── Admin collections ───────────────────────────────
    // Only accessible via Firebase Admin SDK (server-side), not client
    match /adminAuditLog/{logId} {
      allow read, write: if false;
    }
  }
}
