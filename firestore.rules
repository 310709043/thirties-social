rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Posting requires a real, non-banned profile. Treating a missing profile as
    // "not banned" lets a user delete users/{uid} and keep posting with the same
    // auth token, bypassing both moderation and the normal account bootstrap.
    function notBanned() {
      return request.auth != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
    }

    // Client-created profiles are allowed because first launch uses anonymous
    // Firebase Auth, but every economy/moderation field must start at the one
    // canonical free-account value. Admin SDK writes bypass rules, so operator
    // personas and server-side grants are unaffected.
    function validNewUser() {
      return request.resource.data.wicks is int
             && request.resource.data.wicks == 3
             && request.resource.data.vigil == false
             && request.resource.data.setupDone == false
             && request.resource.data.isBanned == false
             && request.resource.data.banReason == null
             && request.resource.data.freeMatchesUsed is int
             && request.resource.data.freeMatchesUsed == 0
             && request.resource.data.loftFreeUsed is int
             && request.resource.data.loftFreeUsed == 0
             && request.resource.data.gender == null;
    }

    function validProfileGender() {
      return request.resource.data.gender == null
             || request.resource.data.gender == 'female'
             || request.resource.data.gender == 'male';
    }

    // ── Users ──────────────────────────────────────────
    match /users/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && validNewUser();
      // Monetization lock: client may only DECREASE wicks (spending stays
      // client-side). Wick increases, vigil and lastRewardDate are server-only
      // (RevenueCat webhook + daily-reward endpoint).
      allow update: if request.auth != null && request.auth.uid == userId
                    && validProfileGender()
                    && !('isBanned' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('banReason' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('vigil' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('lastRewardDate' in request.resource.data.diff(resource.data).affectedKeys())
                    && (!('wicks' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.wicks is int
                            && request.resource.data.wicks >= 0
                            && request.resource.data.wicks <= resource.data.wicks))
                    && (!('freeMatchesUsed' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.freeMatchesUsed >= resource.data.freeMatchesUsed)
                    && (!('loftFreeUsed' in request.resource.data.diff(resource.data).affectedKeys())
                        || !('loftFreeUsed' in resource.data)
                        || request.resource.data.loftFreeUsed >= resource.data.loftFreeUsed);
      // A banned account cannot delete only its profile and immediately recreate
      // an unbanned one with the same Firebase credential. Full account erasure
      // remains available to ordinary users through the in-app deletion flow.
      allow delete: if request.auth != null
                    && request.auth.uid == userId
                    && resource.data.isBanned != true;
    }

    // ── Wicks Transactions ──────────────────────────────
    match /wicksTransactions/{txId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      // Client transactions are spend-only audit records. Wick grants are
      // written by the Admin SDK (daily reward / RevenueCat webhook).
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.amount is int
                    && request.resource.data.amount < 0
                    && request.resource.data.balanceAfter is int
                    && request.resource.data.balanceAfter >= 0
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 40;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Rooms ──────────────────────────────────────────
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null
                    // Sending a message bumps messageCount and extends closesAt.
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['messageCount', 'closesAt']);
      allow delete: if request.auth != null
                    && resource.data.creatorId == request.auth.uid
                    && resource.data.isUserCreated == true;

      // Room messages subcollection
      match /messages/{msgId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 280
                      && get(/databases/$(database)/documents/rooms/$(roomId)).data.isActive == true
                      && get(/databases/$(database)/documents/rooms/$(roomId)).data.closesAt > request.time
                      && notBanned();
        // Only resonance reaction counts may be updated, and only riding the
        // same transaction as the caller's OWN reactions/{uid} subdoc change
        // (the client's reactToRoomMessage transaction). get() sees the
        // pre-transaction subdoc, getAfter() the post-transaction one, so the
        // three legitimate shapes — add, switch, remove — are each verified
        // key-by-key as exactly ±1. Forging counts without a matching subdoc
        // write is rejected.
        function myReaction() {
          return /databases/$(database)/documents/rooms/$(roomId)/messages/$(msgId)/reactions/$(request.auth.uid);
        }
        function oldCount(sym) {
          return resource.data.get('reactions', {}).get(sym, 0);
        }
        function newCount(sym) {
          return request.resource.data.reactions[sym];
        }
        function reactionKeys() {
          return request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys();
        }
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                      && request.resource.data.reactions is map
                      && (
                        // remove: my subdoc deleted; only my previous symbol, −1
                        (exists(myReaction()) && !existsAfter(myReaction())
                          && reactionKeys().hasOnly([get(myReaction()).data.symbol])
                          && newCount(get(myReaction()).data.symbol) == oldCount(get(myReaction()).data.symbol) - 1)
                        ||
                        // add: no prior subdoc; only my new symbol, +1
                        (!exists(myReaction()) && existsAfter(myReaction())
                          && reactionKeys().hasOnly([getAfter(myReaction()).data.symbol])
                          && newCount(getAfter(myReaction()).data.symbol) == oldCount(getAfter(myReaction()).data.symbol) + 1)
                        ||
                        // switch: old symbol −1, new symbol +1
                        (exists(myReaction()) && existsAfter(myReaction())
                          && reactionKeys().hasOnly([get(myReaction()).data.symbol, getAfter(myReaction()).data.symbol])
                          && newCount(get(myReaction()).data.symbol) == oldCount(get(myReaction()).data.symbol) - 1
                          && newCount(getAfter(myReaction()).data.symbol) == oldCount(getAfter(myReaction()).data.symbol) + 1)
                      );
        allow delete: if false;

        // One resonance reaction per user, keyed by uid.
        match /reactions/{reactUid} {
          allow read:   if request.auth != null;
          allow create, update: if request.auth != null
                                && request.auth.uid == reactUid
                                && request.resource.data.symbol is string
                                && request.resource.data.userId == request.auth.uid;
          allow delete: if request.auth != null && request.auth.uid == reactUid;
        }
      }

      // Presence heartbeats — one doc per user, keyed by uid
      match /presence/{presenceUid} {
        allow read:           if request.auth != null;
        allow create, update: if request.auth != null
                              && request.auth.uid == presenceUid;
        allow delete:         if request.auth != null
                              && request.auth.uid == presenceUid;
      }
    }

    // ── Conversations ───────────────────────────────────
    match /conversations/{convId} {
      allow read: if request.auth != null
                  && (resource.data.userAId == request.auth.uid
                      || resource.data.userBId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userAId == request.auth.uid;
      // extendVotes/expiresAt/extended power 續燭 (mutual +30 min extension):
      // expiresAt may only move together with flipping extended false→true, so
      // the clock can never be pushed out a second time.
      allow update: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['messageCount', 'endedAt', 'endedReason',
                                 'extendVotes', 'expiresAt', 'extended',
                                 'rekindleVotes', 'bondVotes', 'seeds'])
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['expiresAt', 'extended'])
                        || (resource.data.get('extended', false) == false
                            && request.resource.data.get('extended', false) == true))
                    // seeds: each participant may only stamp their OWN display
                    // seed — never rewrite the other person's.
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['seeds'])
                        || request.resource.data.get('seeds', {})
                             .diff(resource.data.get('seeds', {})).affectedKeys()
                             .hasOnly([request.auth.uid]));
      allow delete: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid);

      match /messages/{msgId} {
        allow read: if request.auth != null
                    && (get(/databases/$(database)/documents/conversations/$(convId)).data.userAId == request.auth.uid
                        || get(/databases/$(database)/documents/conversations/$(convId)).data.userBId == request.auth.uid);
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 280
                      && get(/databases/$(database)/documents/conversations/$(convId)).data.endedAt == null
                      && get(/databases/$(database)/documents/conversations/$(convId)).data.expiresAt > request.time
                      && notBanned();
        allow update: if false;
        allow delete: if request.auth != null
                      && (get(/databases/$(database)/documents/conversations/$(convId)).data.userAId == request.auth.uid
                          || get(/databases/$(database)/documents/conversations/$(convId)).data.userBId == request.auth.uid);
      }

      // Typing indicator — one doc per participant. Kept OFF the conversation
      // doc so keystrokes don't churn both sides' main subscription (and the
      // old typing_{uid} fields never passed the update whitelist anyway).
      match /typing/{typingUid} {
        allow read:  if request.auth != null
                     && (get(/databases/$(database)/documents/conversations/$(convId)).data.userAId == request.auth.uid
                         || get(/databases/$(database)/documents/conversations/$(convId)).data.userBId == request.auth.uid);
        allow write: if request.auth != null
                     && request.auth.uid == typingUid
                     && (get(/databases/$(database)/documents/conversations/$(convId)).data.userAId == request.auth.uid
                         || get(/databases/$(database)/documents/conversations/$(convId)).data.userBId == request.auth.uid);
      }
    }

    // ── Awake presence（今晚有 N 人醒著）─────────────────
    // One public heartbeat doc per user (timestamp only) so the home screen
    // can honestly count who's around. No personal data lives here.
    match /presence/{presUid} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == presUid;
    }

    // ── 重逢 Rekindles（明晚再見）────────────────────────
    match /rekindles/{rekId} {
      allow read:   if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid);
      // Same mutuality proof as bonds: a rekindle puts a "someone is waiting
      // for you" banner on the other person's home screen. It is created in
      // the SAME transaction as the confirming vote, so getAfter() sees both
      // votes. Legacy shape (no srcConversationId) stays allowed until v16 is
      // out — tighten afterwards.
      allow create: if request.auth != null
                    && (request.resource.data.userAId == request.auth.uid
                        || request.resource.data.userBId == request.auth.uid)
                    && (!('srcConversationId' in request.resource.data)
                        || (getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.srcConversationId)).data.rekindleVotes[request.resource.data.userAId] == true
                            && getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.srcConversationId)).data.rekindleVotes[request.resource.data.userBId] == true));
      // Only opening the reunion may be written (conversationId + status).
      allow update: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['conversationId', 'status']);
      allow delete: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid);
    }

    // ── 熟人 Bonds（留下彼此）────────────────────────────
    match /bonds/{bondId} {
      allow read:   if request.auth != null && request.auth.uid in resource.data.users;
      // A bond is permanent and shows on the other person's profile, so it must
      // be provably mutual: docs carrying srcConversationId are validated
      // against that conversation's bondVotes (both agreed). Docs WITHOUT the
      // field keep the legacy participant-only check so v15-and-earlier builds
      // don't break mid-test — tighten to validated-only once v16 is rolled out.
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users
                    && (!('srcConversationId' in request.resource.data)
                        || (get(/databases/$(database)/documents/conversations/$(request.resource.data.srcConversationId)).data.bondVotes[request.resource.data.users[0]] == true
                            && get(/databases/$(database)/documents/conversations/$(request.resource.data.srcConversationId)).data.bondVotes[request.resource.data.users[1]] == true));
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // ── 夜信 Letters（慢通信）────────────────────────────
    match /letters/{letterId} {
      // Unclaimed letters must be readable so a stranger can claim one;
      // claimed letters are private to sender + recipient.
      allow read:   if request.auth != null
                    && (resource.data.toId == null
                        || resource.data.fromId == request.auth.uid
                        || resource.data.toId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromId == request.auth.uid
                    && request.resource.data.toId == null
                    && request.resource.data.status == 'unsent'
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 500
                    && notBanned();
      allow update: if request.auth != null
                    && (
                      // Claiming: an unclaimed letter becomes mine.
                      (resource.data.toId == null
                       && request.resource.data.toId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['toId', 'status']))
                      ||
                      // Replying: the recipient writes one reply, once.
                      (resource.data.toId == request.auth.uid
                       && !('replyContent' in resource.data)
                       && request.resource.data.replyContent is string
                       && request.resource.data.replyContent.size() <= 500
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['replyContent', 'toSeed', 'repliedAt', 'status'])
                       && notBanned())
                    );
      allow delete: if request.auth != null && resource.data.fromId == request.auth.uid;
    }

    // ── 回聲 Echoes（結束後的最後一句話）─────────────────
    match /echoes/{echoId} {
      allow read:   if request.auth != null
                    && (resource.data.toId == request.auth.uid
                        || resource.data.fromId == request.auth.uid);
      // The echo must come out of a conversation the sender and recipient
      // actually shared — without this check any client could push an echo
      // onto ANY user's home screen (a harassment vector in an anonymous app).
      allow create: if request.auth != null
                    && request.resource.data.fromId == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 200
                    && request.resource.data.read == false
                    && notBanned()
                    && (get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.userAId in [request.resource.data.fromId, request.resource.data.toId])
                    && (get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.userBId in [request.resource.data.fromId, request.resource.data.toId]);
      allow update: if request.auth != null
                    && resource.data.toId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read']);
      allow delete: if request.auth != null
                    && (resource.data.toId == request.auth.uid
                        || resource.data.fromId == request.auth.uid);
    }

    // ── Loft Sessions ───────────────────────────────────
    match /loftSessions/{sessionId} {
      // Anyone can see tonight's sessions (to find others in the Loft)
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ── Loft Ritual Responses (今夜之題) ─────────────────
    match /loftRitualResponses/{responseId} {
      allow read:   if request.auth != null;
      // notBanned: the ritual answer broadcasts to everyone in the Loft — the
      // one place a banned user could still reach an audience without it.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 280
                    && notBanned();
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ── Loft Conversations ──────────────────────────────
    match /loftConversations/{convId} {
      allow read: if request.auth != null
                  && (resource.data.userAId == request.auth.uid
                      || resource.data.userBId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userAId == request.auth.uid;
      // Only allow updating fields that legitimately change during a chat session.
      // veils tracks PAID veil-lift progress per viewer — each participant may
      // only touch their own key, or the other side could lower (or free-up)
      // progress that was bought with wicks.
      allow update: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['messageCount', 'endedAt', 'endedReason', 'veils'])
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['veils'])
                        || request.resource.data.get('veils', {})
                             .diff(resource.data.get('veils', {})).affectedKeys()
                             .hasOnly([request.auth.uid]));
      allow delete: if request.auth != null
                    && (resource.data.userAId == request.auth.uid
                        || resource.data.userBId == request.auth.uid);

      match /messages/{msgId} {
        allow read: if request.auth != null
                    && (get(/databases/$(database)/documents/loftConversations/$(convId)).data.userAId == request.auth.uid
                        || get(/databases/$(database)/documents/loftConversations/$(convId)).data.userBId == request.auth.uid);
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 280
                      && get(/databases/$(database)/documents/loftConversations/$(convId)).data.endedAt == null
                      && get(/databases/$(database)/documents/loftConversations/$(convId)).data.expiresAt > request.time
                      && notBanned();
        allow update: if false;
        allow delete: if request.auth != null
                      && (get(/databases/$(database)/documents/loftConversations/$(convId)).data.userAId == request.auth.uid
                          || get(/databases/$(database)/documents/loftConversations/$(convId)).data.userBId == request.auth.uid);
      }
    }

    // ── Match Queue ─────────────────────────────────────
    match /matchQueue/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Reports ─────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid;
      allow read:   if request.auth != null
                    && resource.data.reporterId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.reporterId == request.auth.uid;
    }

    // ── Veiled Photos ───────────────────────────────────
    match /veiledPhotos/{photoId} {
      // Sender or the other participant of the conversation may read.
      allow read: if request.auth != null
                  && (resource.data.senderId == request.auth.uid
                      || get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.userAId == request.auth.uid
                      || get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.userBId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.senderId == request.auth.uid;
    }

    // ── Analytics ───────────────────────────────────────
    // Write-only event log. This section was MISSING entirely, so every client
    // trackEvent() has been silently permission-denied since launch — the
    // product was flying blind. Create-only: nobody reads analytics from the
    // client (the dashboard uses the Admin SDK).
    match /analytics/{eventId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.event is string
                    && request.resource.data.event.size() <= 40
                    && request.resource.data.params is map;
      allow read, update, delete: if false;
    }

    // ── Admin collections ───────────────────────────────
    // Only accessible via Firebase Admin SDK (server-side), not client
    match /adminAuditLog/{logId} {
      allow read, write: if false;
    }
  }
}
