{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_LOFT_ALWAYS_OPEN": "0"
      },
      "ios": {
        "simulator": true
      },
      "channel": "preview"
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_LOFT_ALWAYS_OPEN": "0"
      },
      "ios": {
        "autoIncrement": true
      },
      "channel": "production"
    }
  }
}
