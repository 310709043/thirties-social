{
  "expo": {
    "name": "燭影私語",
    "slug": "thirties-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF7E8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thirties.social",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "用於選擇照片作為紗罩頭像",
        "NSCameraUsageDescription": "用於拍攝照片作為紗罩頭像"
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "package": "com.thirties.social",
      "adaptiveIcon": {
        "backgroundColor": "#FDF7E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "privacyPolicyUrl": "https://thirties-landing.vercel.app/privacy",
      "supportEmail": "privacy@lowbatterytown.com",
      "ageRating": "17+",
      "category": "SOCIAL_NETWORKING",
      "eas": {
        "projectId": "d2729381-91aa-41ed-b510-c9549b4c8f39"
      }
    },
    "plugins": [
      "react-native-iap",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#e8a557"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "owner": "simontang"
  }
}
